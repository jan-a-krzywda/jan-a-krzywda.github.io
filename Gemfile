source "https://rubygems.org"

# This is the exact bundle GitHub Pages runs on its servers. Using it locally
# means "works on my machine" also means "works once pushed".
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Ruby 3.x removed these from the standard library.
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
